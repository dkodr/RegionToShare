<Window x:Class="RegionToShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:styles="urn:TomsToolbox.Wpf.Styles"
        xmlns:properties="clr-namespace:RegionToShare.Properties"
        Title="Region to Share"
        Height="782" Width="1024"
        MinHeight="200" MinWidth="300"
        Background="Black" Foreground="White">
  <Window.Resources>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#333337" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#464646" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#252526" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#686868" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#9E9E9E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F1F1F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#999999" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource ThemeColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HotTrackBrushKey}" Color="{DynamicResource ThemeColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#F1F1F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#252526" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1B1B1C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#1B1B1C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F1F1F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#333337" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F1F1F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveCaptionBrushKey}" Color="#2D2D30" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="{DynamicResource ThemeColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveCaptionTextBrushKey}" Color="#F1F1F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveCaptionBrushKey}" Color="#2D2D30" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="#434346" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveCaptionTextBrushKey}" Color="#808080" />
    <SolidColorBrush x:Key="{x:Static styles:ResourceKeys.BorderBrush}" Color="#3F3F46" />
    <SolidColorBrush x:Key="{x:Static styles:ResourceKeys.AccentDarkBrush}" Color="{DynamicResource ThemeColor}" />
    <SolidColorBrush x:Key="{x:Static styles:ResourceKeys.DisabledBrush}" Color="#2D2D30" />
  </Window.Resources>
  <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}">
    <Grid x:Name="InfoArea" Background="{Binding InfoAreaBackground}">
      <WrapPanel x:Name="OptionsPanel" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10"
                 Background="Transparent" MouseLeftButtonDown="OptionsPanel_MouseLeftButtonDown">
        <WrapPanel.Resources>
          <Style TargetType="Border" x:Key="Section">
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="VerticalAlignment" Value="Top" />
          </Style>
          <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
          </Style>
          <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
          </Style>
          <Style TargetType="ToggleButton" x:Key="AnchorButton">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:ResourceKeys.BorderBrush}}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="1"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:ResourceKeys.AccentDarkBrush}}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static styles:ResourceKeys.AccentDarkBrush}}" />
              </Trigger>
            </Style.Triggers>
          </Style>
          <Style TargetType="Rectangle" x:Key="AnchorMarker">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" />
          </Style>
          <DataTemplate x:Key="ColorItem">
            <StackPanel Orientation="Horizontal">
              <Border Width="12" Height="12" Margin="0,0,6,0" BorderThickness="1"
                      BorderBrush="{DynamicResource {x:Static styles:ResourceKeys.BorderBrush}}"
                      Background="{Binding Brush}" />
              <TextBlock Text="{Binding Name}" />
            </StackPanel>
          </DataTemplate>
        </WrapPanel.Resources>

        <!-- Region: what is shared -->
        <Border Style="{StaticResource Section}">
          <StackPanel>
            <TextBlock Text="Region" Style="{StaticResource SectionHeader}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Size" Style="{StaticResource Label}" />
              <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" HorizontalAlignment="Left"
                        Text="{Binding Extend}"
                        ItemsSource="{Binding Resolutions}"
                        ToolTip="Size of the shared region in pixels; type your own or pick one (list in %AppData%\RegionToShare\resolutions.txt)"
                        Width="110" IsEditable="True" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Aspect ratio" Style="{StaticResource Label}" />
              <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" HorizontalAlignment="Left"
                        SelectedItem="{Binding AspectRatio, Source={x:Static properties:Settings.Default}}"
                        ItemsSource="{Binding AspectRatios}"
                        ToolTip="Keep this aspect ratio while resizing; the width leads, the height follows"
                        Width="110" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Anchor" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,4,8,0" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                <UniformGrid x:Name="AnchorGrid" Rows="3" Columns="3" VerticalAlignment="Top"
                             ToolTip="Stick the window to an edge or corner of the screen; dragging the window releases it">
                <ToggleButton Tag="0" Style="{StaticResource AnchorButton}" Checked="AnchorButton_Checked" Unchecked="AnchorButton_Unchecked">
                  <Rectangle Style="{StaticResource AnchorMarker}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ToggleButton>
                <ToggleButton Tag="1" Style="{StaticResource AnchorButton}" Checked="AnchorButton_Checked" Unchecked="AnchorButton_Unchecked">
                  <Rectangle Style="{StaticResource AnchorMarker}" HorizontalAlignment="Center" VerticalAlignment="Top" />
                </ToggleButton>
                <ToggleButton Tag="2" Style="{StaticResource AnchorButton}" Checked="AnchorButton_Checked" Unchecked="AnchorButton_Unchecked">
                  <Rectangle Style="{StaticResource AnchorMarker}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </ToggleButton>
                <ToggleButton Tag="3" Style="{StaticResource AnchorButton}" Checked="AnchorButton_Checked" Unchecked="AnchorButton_Unchecked">
                  <Rectangle Style="{StaticResource AnchorMarker}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </ToggleButton>
                <ToggleButton Tag="4" Style="{StaticResource AnchorButton}" Checked="AnchorButton_Checked" Unchecked="AnchorButton_Unchecked">
                  <Rectangle Style="{StaticResource AnchorMarker}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ToggleButton>
                <ToggleButton Tag="5" Style="{StaticResource AnchorButton}" Checked="AnchorButton_Checked" Unchecked="AnchorButton_Unchecked">
                  <Rectangle Style="{StaticResource AnchorMarker}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </ToggleButton>
                <ToggleButton Tag="6" Style="{StaticResource AnchorButton}" Checked="AnchorButton_Checked" Unchecked="AnchorButton_Unchecked">
                  <Rectangle Style="{StaticResource AnchorMarker}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                </ToggleButton>
                <ToggleButton Tag="7" Style="{StaticResource AnchorButton}" Checked="AnchorButton_Checked" Unchecked="AnchorButton_Unchecked">
                  <Rectangle Style="{StaticResource AnchorMarker}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </ToggleButton>
                <ToggleButton Tag="8" Style="{StaticResource AnchorButton}" Checked="AnchorButton_Checked" Unchecked="AnchorButton_Unchecked">
                  <Rectangle Style="{StaticResource AnchorMarker}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </ToggleButton>
                </UniformGrid>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.8" MaxWidth="200" TextWrapping="Wrap"
                           Text="Sticks the window to a screen edge or corner, also after resizing. Dragging the window releases it." />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Appearance: what viewers see where nothing covers the region -->
        <Border Style="{StaticResource Section}">
          <StackPanel>
            <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Frame color" Style="{StaticResource Label}" />
              <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" HorizontalAlignment="Left"
                        SelectedValue="{Binding ThemeColor, Source={x:Static properties:Settings.Default}}"
                        SelectedValuePath="Name"
                        ItemsSource="{Binding ThemeColorItems}"
                        ItemTemplate="{StaticResource ColorItem}"
                        ToolTip="Color of the region frame stripes and of the UI accents"
                        Width="120" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Background" Style="{StaticResource Label}" />
              <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" HorizontalAlignment="Left"
                        SelectedValue="{Binding BackgroundColor, Source={x:Static properties:Settings.Default}}"
                        SelectedValuePath="Name"
                        ItemsSource="{Binding BackgroundColorItems}"
                        ItemTemplate="{StaticResource ColorItem}"
                        IsEnabled="{Binding IsBackgroundColorEnabled}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="{Binding BackgroundColorToolTip}"
                        Width="120" />
              <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2"
                        Content="Show desktop wallpaper"
                        ToolTip="Paint the desktop wallpaper where nothing covers the shared region, instead of the background color"
                        IsChecked="{Binding ShowDesktopWallpaper, Source={x:Static properties:Settings.Default}}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Capture: how the region is recorded -->
        <Border Style="{StaticResource Section}">
          <StackPanel>
            <TextBlock Text="Capture" Style="{StaticResource SectionHeader}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Frame rate" Style="{StaticResource Label}" />
              <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" HorizontalAlignment="Left"
                        SelectedItem="{Binding FramesPerSecond, Source={x:Static properties:Settings.Default}}"
                        ItemStringFormat="{}{0} FPS"
                        ItemsSource="{Binding SupportedFramesPerSecond}"
                        ToolTip="How many times per second the region is captured; higher is smoother but uses more CPU"
                        Width="80" />
              <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2"
                        Content="Draw mouse cursor"
                        ToolTip="Screen capture does not include the mouse cursor; this draws it into the shared image"
                        IsChecked="{Binding DrawShadowCursor, Source={x:Static properties:Settings.Default}}" />
              <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2"
                        Content="Start sharing on launch"
                        ToolTip="Open the region frame immediately when the app starts, without clicking the window"
                        IsChecked="{Binding StartActivated, Source={x:Static properties:Settings.Default}}" />
            </Grid>
          </StackPanel>
        </Border>
      </WrapPanel>
      <TextBlock Text="{Binding Version}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Padding="5,2" />
      <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
          <RowDefinition Height="1*" />
          <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Ellipse Grid.Row="1" Width="128" Height="128"
                 Fill="{Binding Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" />
        <Path Grid.Row="1" Width="80" Height="80"
              Fill="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
              Data="M 20,0 L80,40 L20,80 Z" />
      </Grid>
    </Grid>
    <Image x:Name="RenderTarget" Visibility="Hidden" MouseDown="SubLayer_MouseDown" />
  </Grid>
</Window>